# Reserved for future application configuration. Never commit real secrets.
# LLM_API_KEY=
# DATABASE_URL=
# JUPYTER_SERVER_URL=
# JUPYTER_SERVER_TOKEN=

# Local-First RAG & Interchangeable Model Providers (ADR-0007 / Task 029)
# Embedding provider: local_deterministic (default offline), openai, gemini
# AI_EMBEDDING_PROVIDER=local_deterministic
# AI_EMBEDDING_MODEL=token-hash-bow-v1
# AI_EMBEDDING_DIMENSIONS=128

# Generation provider: retrieval_only (default fallback), openai, anthropic, gemini
# AI_GENERATION_PROVIDER=retrieval_only
# AI_GENERATION_MODEL=deterministic-extractive-fallback

# Provider API credentials (read from environment only; never commit real keys)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Local persistent storage paths
# AI_SQLITE_DB_PATH=data/runtime/inventory.sqlite
# AI_CHROMA_PERSIST_DIR=data/runtime/chroma
