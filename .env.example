# Reserved for future application configuration. Never commit real secrets.
# LLM_API_KEY=
# DATABASE_URL=
# JUPYTER_SERVER_URL=
# JUPYTER_SERVER_TOKEN=

# Local-First RAG & Interchangeable Model Providers (ADR-0007 / Task 029)
# Embedding provider: local_deterministic (default offline), openai, gemini
# AI_LEARNING_EMBEDDING_PROVIDER=local_deterministic
# AI_LEARNING_EMBEDDING_MODEL=token-hash-bow-v1
# AI_LEARNING_EMBEDDING_DIMENSIONS=128

# Generation provider: retrieval_only (default fallback), openai, anthropic, gemini
# AI_LEARNING_GENERATION_PROVIDER=retrieval_only
# AI_LEARNING_GENERATION_MODEL=none

# Persistent local Chroma vector collection name
# AI_LEARNING_CHROMA_COLLECTION=ai_research_knowledge_chunks_v1

# Provider API credentials (read from environment only; never commit real keys)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GEMINI_API_KEY=your-gemini-developer-api-key-here
